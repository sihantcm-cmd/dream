# Copy this file to .env and add DeepSeek + Beijing DashScope keys to enable AI.
AI_TEXT_PROVIDER=deepseek
AI_MEDIA_PROVIDER=dashscope
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=max
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen-audio-3.1-asr-flash
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
# Optional: Beijing workspace ID. Blank uses the supported shared endpoint.
DASHSCOPE_WORKSPACE_ID=
# Optional Gemini alternative; set the relevant provider above to gemini to use it.
GEMINI_API_KEY=

# The server listens on PORT and HOST. DATA_DIR stores the archive and generated images.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Override these only if your Gemini account uses different model access.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
